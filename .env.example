# URL pública do site (opcional: sem valor, o código usa http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — exigidas pelo código (lib/supabase/server.ts, lib/supabase/client.ts, proxy.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Não lida pelo código da aplicação no HEAD atual.
# Manter somente se algum fluxo operacional (deploy, CLI, CI) exigir; caso contrário, remover em etapa própria.
SUPABASE_SECRET_KEY=
